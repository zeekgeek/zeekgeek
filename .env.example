# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file.

# Port the automation server listens on.
PORT=3000

# Shared secret that protects every automation request.
# Generate a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# You will paste this same value into the Apple Shortcut on Andrew's iPhone/iPad.
ACCESS_TOKEN=change-me-to-a-long-random-secret

# Comma-separated list of origins allowed to call the API from a browser (the PWA).
# Use "*" only for local testing.
ALLOWED_ORIGINS=*

# Optional: a friendly name the assistant uses when it talks back.
ASSISTANT_NAME=Zeek

# Optional: the user's name, used for warmer spoken responses.
USER_NAME=Andrew
