{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EtsyAISwarmState",
  "type": "object",
  "required": ["updated_at", "metrics", "agents", "logs"],
  "properties": {
    "updated_at": {
      "type": "string",
      "description": "ISO-8601 timestamp of the last state write"
    },
    "metrics": {
      "type": "object",
      "required": [
        "listings_generated",
        "successful_uploads",
        "compute_cost_usd",
        "scrape_runs",
        "successes",
        "errors"
      ],
      "properties": {
        "listings_generated": { "type": "integer", "minimum": 0 },
        "successful_uploads": { "type": "integer", "minimum": 0 },
        "compute_cost_usd": { "type": "number", "minimum": 0 },
        "scrape_runs": { "type": "integer", "minimum": 0 },
        "successes": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "last_active", "health", "success_count", "error_count"],
        "properties": {
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "description": "Human-readable activity, e.g. Scraping, Writing SEO, Idle"
          },
          "last_active": { "type": "string" },
          "health": {
            "type": "string",
            "enum": ["healthy", "warning", "error", "idle"]
          },
          "success_count": { "type": "integer", "minimum": 0 },
          "error_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "level", "message"],
        "properties": {
          "timestamp": { "type": "string" },
          "level": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
